; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Navizin"
config/description="MMORPG 2D naval em pixel art"
run/main_scene="res://scenes/world/ocean_map.tscn"
config/features=PackedStringArray("4.7")

[autoload]

GameManager="*res://scripts/autoload/game_manager.gd"
NetworkClient="*res://scripts/autoload/network_client.gd"
WindManager="*res://scripts/singletons/wind_manager.gd"
SceneTransitionManager="*res://scripts/autoload/scene_transition_manager.gd"
ReputationManager="*res://scripts/autoload/reputation_manager.gd"
CaptainAttributes="*res://scripts/autoload/captain_attributes.gd"
ItemDatabase="*res://scripts/autoload/item_database.gd"
CraftingManager="*res://scripts/managers/crafting_manager.gd"
EnchantmentManager="*res://scripts/managers/enchantment_manager.gd"
UIManager="*res://scripts/ui/ui_manager.gd"
ShipInventory="*res://scripts/autoload/ship_inventory.gd"
CaptainInventory="*res://scripts/autoload/captain_inventory.gd"
OfficerRoster="*res://scripts/autoload/officer_roster.gd"
BoardingManager="*res://scripts/autoload/boarding_manager.gd"
TavernHireSystem="*res://scripts/autoload/tavern_hire_system.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[gui]

theme/custom="res://assets/ui/theme_navizin.tres"

