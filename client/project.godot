; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Navizin"
config/description="MMORPG 2D naval em pixel art"
run/main_scene="res://scenes/world/ocean_map.tscn"
config/features=PackedStringArray("4.7")

[autoload]

GameManager="*res://scripts/autoload/game_manager.gd"
NetworkClient="*res://scripts/autoload/network_client.gd"
WindManager="*res://scripts/singletons/wind_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[gui]

theme/custom="res://assets/ui/theme_navizin.tres"

